     public long getTxPackets(String iface) {
+        // [zerofltectc] 3.10 内核上 TrafficStats 走 netd BPF，会让 system_server 在
+        // WifiHandlerThre 线程 SIGABRT。这里短路掉（返回 UNSUPPORTED=-1）。
+        if (android.os.SystemProperties.getBoolean("persist.wifi.skip_traffic_stats", true)) {
+            return TrafficStats.UNSUPPORTED;
+        }
         return TrafficStats.getTxPackets(iface);
     }
 
